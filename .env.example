# mock: existing demo screens without a backend; api: authenticated real data
NEXT_PUBLIC_DATA_MODE=mock

# Next.js server -> Spring Boot (the browser uses the same-origin /api proxy)
BACKEND_URL=http://127.0.0.1:8080

# Optional presentation-only one-click admin login (requires api data mode).
# These values are read ONLY by the Next.js server. Use an existing ACTIVE ADMIN.
DEMO_ADMIN_LOGIN_ENABLED=false
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
# Set false ONLY for a local production build over plain HTTP.
# COOKIE_SECURE=false
